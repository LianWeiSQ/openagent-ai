OTEL_COLLECTOR_VERSION=0.157.0
PROMETHEUS_VERSION=v3.12.0
TEMPO_VERSION=2.10.7
LOKI_VERSION=3.7.2
GRAFANA_VERSION=13.1.0

OBSERVABILITY_BIND_ADDRESS=127.0.0.1
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
PROMETHEUS_RETENTION=15d
