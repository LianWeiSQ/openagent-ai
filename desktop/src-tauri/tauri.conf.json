{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenAgent",
  "version": "0.1.0",
  "identifier": "ai.openagent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build && cargo build -p openagent-http-runtime --release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenAgent",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "resources": {
      "../../target/release/openagent-http-runtime": "openagent-http-runtime"
    }
  }
}
